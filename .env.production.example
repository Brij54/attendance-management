# ═══════════════════════════════════════════════════════════════
#  PRODUCTION ENVIRONMENT CONFIGURATION (.env.production.example)
#  Copy this file to .env.production on the server and update secrets:
#    cp .env.production.example .env.production
#    chmod 600 .env.production
# ═══════════════════════════════════════════════════════════════

# General Application Settings
APP_NAME="IIIT-B Faculty Attendance API"
ENVIRONMENT=production

# Security: Generate a strong 64-char key using: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_GENERATED_64_CHAR_HEX_SECRET
ACCESS_TOKEN_MINUTES=480

# PostgreSQL Database Configuration
POSTGRES_USER=faculty_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=faculty_attendance_db
# Database connection string used by FastAPI backend
DATABASE_URL=postgresql://faculty_admin:REPLACE_WITH_STRONG_DB_PASSWORD@attendance-prod-postgres:5432/faculty_attendance_db

# Role Credentials
# For security, you can specify plain passwords or SHA-256 hashes (echo -n "yourpass" | sha256sum)
COORDINATOR_USERNAME=coordinator
COORDINATOR_PASSWORD=REPLACE_WITH_STRONG_COORDINATOR_PASSWORD
COORDINATOR_PASSWORD_HASH=

DEAN_FACULTY_USERNAME=dean-faculty
DEAN_FACULTY_PASSWORD=REPLACE_WITH_STRONG_DEAN_PASSWORD
DEAN_FACULTY_PASSWORD_HASH=

# File Upload Limit (in Megabytes)
MAX_UPLOAD_MB=50
TEMP_DIR=/tmp/faculty_punchin

# CORS Configuration
# Allowed frontends that can make cross-origin requests to this backend
CORS_ORIGINS=https://faculty-report.iiitb.net,https://apifaculty-report.iiitb.net,http://faculty-report.iiitb.net,http://apifaculty-report.iiitb.net

# Frontend Backend Connection
# Inside Docker, frontend communicates with backend via the internal service name:
API_URL=http://attendance-backend:8000
# External URL: https://apifaculty-report.iiitb.net
